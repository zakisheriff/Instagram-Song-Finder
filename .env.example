# Copy to .env.local for development. Never commit real values.

# Spotify Web API credentials (Client Credentials flow, server-side only).
# Create an app at https://developer.spotify.com/dashboard and copy both values.
# They must be set together. Without them the site still works for text and
# ISRC searches through the Deezer fallback, but Spotify links cannot be looked up.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Comma-separated catalog order. Default: spotify,deezer
# Use "spotify" alone to disable the Deezer fallback.
# MUSIC_PROVIDERS=spotify,deezer
