# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reference bundle: third-party fonts, images and scripts kept local only
/www.instagram.com-clone/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# local tooling
/.claude/

# raw demo recording: only the compressed copy in public/ is published
/assets/demo/
